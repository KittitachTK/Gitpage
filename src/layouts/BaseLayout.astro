---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import World from '../components/World.astro';
import { BASE, SITE, href } from '../lib/config';
import { getVault } from '../lib/vault/vault';
import { sectionCss } from '../lib/site';
import { poseAttr, scenePose } from '../lib/world';

interface Props {
  title?: string;
  description?: string;
  /** Which top-level nav item is current. */
  nav?: 'home' | 'universe' | 'library' | 'research' | 'ideas' | 'tags' | 'about' | 'search';
  /** Where this page stands in the painted garden (lib/world.ts). Defaults from `nav`. */
  scene?: string;
}

const { title, nav } = Astro.props;
const sceneByNav: Record<string, string> = { home: 'home', library: 'garden', universe: 'tree', research: 'research', ideas: 'ideas' };
const scene = Astro.props.scene ?? sceneByNav[nav ?? ''] ?? 'meadow';
const pose = poseAttr(scenePose(scene));
const description = Astro.props.description || SITE.description;
const pageTitle = title ? `${title} — ${SITE.name}` : `${SITE.name} · ${SITE.subtitle}`;
const links: { key: Props['nav']; label: string; url: string }[] = [
  { key: 'universe', label: 'Tree of Knowledge', url: href('universe') },
  { key: 'library', label: 'Library', url: href('library') },
  { key: 'research', label: 'Research', url: href('research') },
  { key: 'ideas', label: 'Ideas', url: href('ideas') },
  { key: 'tags', label: 'Topics', url: href('tags') },
  // About is a vault note (About.md); only link it when it exists.
  ...(getVault().bySlug.has('about') ? [{ key: 'about' as const, label: 'About', url: href('about') }] : []),
];
---

<!doctype html>
<html lang="en" data-base={BASE} data-art={href('art/')} data-scene={scene} data-pose={pose}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#12140f" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <link rel="icon" href={href('favicon.svg')} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600&family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=IBM+Plex+Sans+Thai:wght@400;500;600&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;600&family=Noto+Serif+Thai:wght@500;600&display=swap"
    />
    <ClientRouter />
    <!--
      Render-blocking on purpose: preferences must be on <html> before first paint.
      ClientRouter replaces <html>'s attributes on every navigation, so the same
      function runs again after each swap (before the new page is shown).
    -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const motionOk = () =>
          root.dataset.motion === 'on' ||
          (root.dataset.motion !== 'off' && !matchMedia('(prefers-reduced-motion: reduce)').matches);
        const prefs = (doc) => {
          const r = doc.documentElement;
          try {
            // An explicit choice from the header toggle wins; otherwise follow the OS.
            const saved = localStorage.getItem('planktos:motion');
            if (saved === 'on' || saved === 'off') r.dataset.motion = saved;
            // Dusk is the default; the header toggle can switch to the light (fresco) theme.
            if (localStorage.getItem('planktos:theme') === 'light') r.dataset.theme = 'light';
            // The home page's opening sequence plays once per session, with motion on.
            if (r.dataset.scene === 'home' && !sessionStorage.getItem('planktos:intro') && motionOk()) {
              r.classList.add('home-intro');
              sessionStorage.setItem('planktos:intro', '1');
            }
          } catch {}
          const meta = doc.querySelector('meta[name="theme-color"]');
          if (meta) meta.content = r.dataset.theme === 'light' ? '#f3ecdc' : '#12140f';
        };
        prefs(document);
        // First load only: if the 3D world is likely, keep the 2D painting hidden until it decides
        // (components/World.astro clears this), so the page doesn't show one and then the other.
        try {
          const saveData = navigator.connection && navigator.connection.saveData;
          if (motionOk() && !saveData && document.createElement('canvas').getContext('webgl2')) root.classList.add('world-pending');
        } catch {}

        // ---- a note title morphs between a list item / card and the page heading ----
        const norm = (u) => {
          const x = new URL(u, location.href);
          return x.origin + x.pathname.replace(/\/?$/, '/');
        };
        const titleLinkingTo = (doc, url) => {
          const target = norm(url);
          for (const a of doc.querySelectorAll('a[href]')) {
            if (norm(a.href) !== target) continue;
            const t = a.querySelector('[data-vt-title]');
            if (t) return t;
          }
          return null;
        };
        const named = [];
        const morph = (el) => {
          if (!el) return;
          el.style.viewTransitionName = 'vt-title';
          named.push(el);
        };
        let from = location.href;
        // Old page: name the item that was clicked (opening) or our own heading (leaving).
        document.addEventListener('astro:before-preparation', (e) => {
          from = location.href;
          if (motionOk()) morph(titleLinkingTo(document, e.to) || document.querySelector('h1[data-vt-title]'));
        });
        // New page: name the item for the page we came from (going back) or its own heading.
        document.addEventListener('astro:before-swap', (e) => {
          prefs(e.newDocument);
          if (!motionOk()) return;
          const doc = e.newDocument;
          morph(titleLinkingTo(doc, from) || doc.querySelector('h1[data-vt-title]'));
          // Entering the tree of knowledge: a short dive into the night garden.
          if (norm(e.to) === norm(root.dataset.base + 'universe')) doc.documentElement.dataset.vt = 'warp';
          const done = () => {
            named.splice(0).forEach((el) => (el.style.viewTransitionName = ''));
            delete root.dataset.vt;
          };
          if (e.viewTransition) e.viewTransition.finished.finally(done);
          else setTimeout(done, 1000);
        });
      })();
    </script>
    <!-- Subject colours, generated from the vault's folders (lib/garden.ts). -->
    <style is:inline set:html={sectionCss(getVault())}></style>
    <slot name="head" />
  </head>
  <body>
    <a class="sr-only" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container">
        <a class="brand" href={href('')}><span class="star">❦</span>{SITE.name}<small>{SITE.subtitle}</small></a>
        <nav class="nav" aria-label="Main">
          {links.map((l) => <a href={l.url} aria-current={nav === l.key ? 'page' : undefined}>{l.label}</a>)}
        </nav>
        <form class="header-search" action={href('search')} method="get" role="search">
          <label class="sr-only" for="q">Search the archive</label>
          <input id="q" name="q" type="search" placeholder="Search the archive…  /" autocomplete="off" />
        </form>
        <button class="motion-toggle" type="button" aria-pressed="true" aria-label="Animations on" title="Animations: on">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <circle cx="12" cy="12" r="2.4" fill="currentColor" stroke="none"></circle>
            <g class="orbit"><ellipse cx="12" cy="12" rx="9" ry="4.2" transform="rotate(-25 12 12)"></ellipse><circle cx="20.2" cy="8.4" r="1.3" fill="currentColor" stroke="none"></circle></g>
            <line class="slash" x1="4" y1="20" x2="20" y2="4"></line>
          </svg>
        </button>
        <button class="theme-toggle" type="button" aria-label="Switch to light theme" title="Switch to light theme">
          <!-- Day/night switch adapted from Uiverse.io (rishichawda); styles in global.css. -->
          <span class="tt-sky" aria-hidden="true"><span class="tt-stars"></span><span class="tt-cloud"></span></span>
          <span class="tt-knob" aria-hidden="true"></span>
        </button>
        <button class="menu-toggle" type="button" aria-expanded="false">Menu</button>
      </div>
    </header>

    <World />

    <main id="main">
      <slot />
    </main>

    <!-- Back-to-top adapted from Uiverse.io (vinodjangid07); styles in global.css. -->
    <button class="to-top" type="button" aria-label="Back to top">
      <svg viewBox="0 0 384 512" aria-hidden="true"><path d="M214.6 41.4c-12.5-12.5-32.8-12.5-45.3 0l-160 160c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0L160 141.2V448c0 17.7 14.3 32 32 32s32-14.3 32-32V141.2L329.4 246.6c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3l-160-160z"></path></svg>
      <span class="to-top-label" aria-hidden="true">Back to top</span>
    </button>

    <footer class="site-footer">
      <div class="container">
        <span>✦ {SITE.name} — {SITE.tagline}</span>
        <span>Written in Obsidian · versioned with Git · built with Astro</span>
        <span class="credits">Paintings: Michelangelo, <i>The Creation of Adam</i> (c. 1512) · Thomas Cole, <i>The Garden of Eden</i> (1828) — public domain</span>
      </div>
    </footer>

    <script>
      import { motionEnabled, onMotionChange, setMotion } from '../scripts/motion';
      import { all, listen, onPage } from '../scripts/lifecycle';

      const root = document.documentElement;

      // ---- document-wide behaviour (registered once; survives navigation) ----

      // Buttons: a soft ripple from where they were pressed.
      document.addEventListener('pointerdown', (e) => {
        const btn = (e.target as Element).closest?.<HTMLElement>('.btn');
        if (!btn || !motionEnabled()) return;
        const r = btn.getBoundingClientRect();
        btn.style.setProperty('--rx', `${e.clientX - r.left}px`);
        btn.style.setProperty('--ry', `${e.clientY - r.top}px`);
        btn.classList.remove('rippling');
        void btn.offsetWidth; // restart the animation
        btn.classList.add('rippling');
      });
      document.addEventListener('animationend', (e) => {
        if ((e.target as Element).classList?.contains('rippling')) (e.target as Element).classList.remove('rippling');
      });

      // Library cards: a glow on the border follows the pointer.
      document.addEventListener('pointermove', (e) => {
        if (e.pointerType !== 'mouse') return;
        const card = (e.target as Element).closest?.<HTMLElement>('.card');
        if (!card) return;
        const r = card.getBoundingClientRect();
        card.style.setProperty('--mx', `${e.clientX - r.left}px`);
        card.style.setProperty('--my', `${e.clientY - r.top}px`);
      });

      // "/" focuses search, like most documentation sites.
      document.addEventListener('keydown', (e) => {
        const t = e.target as HTMLElement;
        if (e.key !== '/' || /INPUT|TEXTAREA/.test(t.tagName) || t.isContentEditable) return;
        e.preventDefault();
        const input = document.querySelector<HTMLInputElement>('#search-page-input') ?? document.querySelector<HTMLInputElement>('#q');
        if (input && getComputedStyle(input).display !== 'none' && input.offsetParent) input.focus();
        else location.href = document.querySelector<HTMLFormElement>('.header-search')!.action;
      });

      // ---- the header and back-to-top button (new elements on every page) ----
      onPage(() => {
        const motionBtn = document.querySelector<HTMLButtonElement>('.motion-toggle')!;
        const syncMotionBtn = (on: boolean) => {
          motionBtn.setAttribute('aria-pressed', String(on));
          motionBtn.setAttribute('aria-label', on ? 'Animations on' : 'Animations off');
          motionBtn.title = on ? 'Animations: on' : 'Animations: off';
        };
        syncMotionBtn(motionEnabled());
        const offMotion = onMotionChange(syncMotionBtn);
        motionBtn.addEventListener('click', () => setMotion(!motionEnabled()));

        const themeBtn = document.querySelector<HTMLButtonElement>('.theme-toggle')!;
        const syncThemeBtn = () => {
          const label = root.dataset.theme === 'light' ? 'Switch to dark theme' : 'Switch to light theme';
          themeBtn.setAttribute('aria-label', label);
          themeBtn.title = label;
        };
        syncThemeBtn();
        themeBtn.addEventListener('click', () => {
          const light = root.dataset.theme !== 'light';
          if (light) root.dataset.theme = 'light';
          else delete root.dataset.theme;
          document.querySelector<HTMLMetaElement>('meta[name="theme-color"]')!.content = light ? '#f3ecdc' : '#12140f';
          try { localStorage.setItem('planktos:theme', light ? 'light' : 'dark'); } catch {}
          syncThemeBtn();
          // Canvas graphs, diagrams and the world re-read their colours.
          document.dispatchEvent(new Event('themechange'));
        });

        // Back to top: shown once the reader is well down a long page.
        const toTop = document.querySelector<HTMLButtonElement>('.to-top')!;
        let toTopRaf = 0;
        const syncToTop = () => {
          toTopRaf = 0;
          toTop.classList.toggle('shown', scrollY > Math.max(600, innerHeight));
        };
        const offScroll = listen(window, 'scroll', () => { if (!toTopRaf) toTopRaf = requestAnimationFrame(syncToTop); }, { passive: true });
        syncToTop();
        toTop.addEventListener('click', () => {
          scrollTo({ top: 0, behavior: motionEnabled() ? 'smooth' : 'auto' });
          document.querySelector<HTMLElement>('.brand')?.focus({ preventScroll: true });
        });

        const header = document.querySelector<HTMLElement>('.site-header')!;
        const toggle = header.querySelector<HTMLButtonElement>('.menu-toggle')!;
        toggle.addEventListener('click', () => {
          const open = header.toggleAttribute('data-open');
          toggle.setAttribute('aria-expanded', String(open));
        });

        return all(offMotion, offScroll, () => cancelAnimationFrame(toTopRaf));
      });
    </script>
  </body>
</html>
