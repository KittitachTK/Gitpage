---
import BaseLayout from '../layouts/BaseLayout.astro';
import NoteList from '../components/NoteList.astro';
import { SITE, href } from '../lib/config';
import { recent, sections } from '../lib/site';
import { getVault } from '../lib/vault/vault';
import { colorVar, shelfBook } from '../components/Shelf/data';
import type { HomeModule } from '../scripts/home3d';

const vault = getVault();
const secs = sections(vault).filter((s) => s.notes.length);
const latest = recent(vault, 6);
// Shelf modules orbiting the archive station in the 3D hero (one per section with notes).
const orbit: HomeModule[] = secs.map((s) => ({
  id: s.slug,
  label: s.label,
  color: colorVar(s.color),
  url: href(`library/${s.slug}`),
  count: s.notes.length,
  books: recent(vault, 8, (n) => s.notes.includes(n)).map(shelfBook),
}));
const stats = [
  { n: vault.notes.length, label: 'notes' },
  { n: vault.graph.links.length, label: 'connections' },
  { n: vault.tags.size, label: 'topics' },
];
---

<BaseLayout nav="home">
  <section class="hero space">
    <!--
      Decide before the hero paints whether to play the opening sequence: once per
      session, and only with motion on. Inline so there is no flash of final state.
    -->
    <script is:inline>
      (function () {
        var r = document.documentElement, seen = null;
        var ok = r.dataset.motion === 'on' ||
          (r.dataset.motion !== 'off' && !matchMedia('(prefers-reduced-motion: reduce)').matches);
        try { seen = sessionStorage.getItem('planktos:intro'); } catch (e) {}
        if (ok && !seen) {
          r.classList.add('home-intro');
          try { sessionStorage.setItem('planktos:intro', '1'); } catch (e) {}
        }
      })();
    </script>
    <canvas class="hero-nebula" aria-hidden="true"></canvas>
    <canvas class="hero-sky" aria-hidden="true"></canvas>
    <canvas class="hero-3d" aria-hidden="true"></canvas>
    <nav class="orbit-links" aria-label="Shelf modules in orbit">
      {orbit.map((m) => (
        <a class="orbit-link" href={m.url} data-id={m.id} style={`--dot:var(${m.color})`}>
          <span class="orbit-label"><span class="section-dot" />{m.label} <small>{m.count}</small></span>
        </a>
      ))}
    </nav>
    <script type="application/json" class="orbit-data" set:html={JSON.stringify(orbit).replace(/</g, '\\u003c')} />
    <div class="hero-inner container">
      <div class="hero-text">
      <p class="eyebrow intro-step" style="--d:150ms">{SITE.tagline}</p>
      <h1 aria-label={`${SITE.name} ${SITE.subtitle}`}>
        <span class="word" aria-hidden="true">
          {[...SITE.name].map((ch, i) => <span class="ch" style={`--i:${i}`}>{ch}</span>)}
        </span>
        <span class="sub intro-step" style="--d:900ms" aria-hidden="true">{SITE.subtitle}</span>
      </h1>
      <p class="hero-motto intro-step" style="--d:1100ms">Explore the unknown</p>
      <p class="hero-copy intro-step" style="--d:1200ms">{SITE.description}</p>
      <div class="hero-actions intro-step" style="--d:1300ms">
        <a class="btn" href={href('library')} data-warp>Enter archive</a>
        <a class="btn ghost galaxy" href={href('universe')}><span class="sky" aria-hidden="true"></span><span class="label">Knowledge universe ✦</span></a>
      </div>
      <p class="hero-stats intro-step" style="--d:1400ms">
        {stats.map((s, i) => (
          <>
            {i > 0 && ' · '}
            <span data-count={s.n}>{s.n}</span> {s.label}
          </>
        ))}
      </p>
      </div>
      <!-- The 3D station is framed in this box (scripts/home3d.ts). -->
      <div class="hero-stage" aria-hidden="true"></div>
    </div>
  </section>

  <section class="container home-block">
    <p class="eyebrow">Knowledge universe</p>
    <a class="mini-universe space" href={href('universe')} aria-label="Open the Knowledge Universe">
      <canvas class="mini-canvas" aria-hidden="true"></canvas>
      <span class="mini-caption">
        <strong>{vault.notes.length} stars · {vault.graph.links.length} connections</strong>
        <span>Every note is a star; every link, a connection. Explore →</span>
      </span>
    </a>
  </section>

  <section class="container home-block">
    <p class="eyebrow">Library</p>
    <div class="grid home-cards" style="margin-top:16px">
      {
        secs.map((s) => (
          <a class="card" href={href(`library/${s.slug}`)} style={`--glow:${s.color}`}>
            <span class="count">
              <span class="section-dot" style={`--dot:${s.color}`} />
              {s.notes.length} notes
            </span>
            <h3 data-vt-title>{s.label}</h3>
            <p>{s.blurb}</p>
          </a>
        ))
      }
    </div>
  </section>

  <section class="container home-block home-recent">
    <p class="eyebrow"><span class="signal" aria-hidden="true"></span>Recent transmissions</p>
    <NoteList notes={latest} excerpt />
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: min(88vh, 820px);
    display: grid;
    place-items: center;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
    background:
      radial-gradient(ellipse 60% 50% at 70% 30%, rgb(169 163 198 / 0.07), transparent 70%),
      radial-gradient(ellipse 50% 40% at 25% 70%, rgb(var(--accent-rgb) / 0.05), transparent 70%),
      var(--bg);
  }
  .hero-sky, .hero-nebula { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hero-nebula { opacity: 0; transition: opacity 2.4s var(--ease-out); }
  .hero-nebula:global(.ready) { opacity: 1; }
  .hero-inner {
    position: relative; z-index: 3; width: 100%; padding-top: 48px; padding-bottom: 48px; pointer-events: none;
    display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); align-items: center; gap: clamp(16px, 3vw, 48px);
    transition: opacity 500ms var(--ease-out), transform 900ms var(--ease-in);
  }
  .hero-text { position: relative; text-align: left; }
  .hero-stage { min-height: min(68vh, 620px); }
  @media (max-width: 900px) {
    .hero-inner { grid-template-columns: minmax(0, 1fr); gap: 0; padding-bottom: 24px; }
    .hero-text { text-align: center; }
    .hero-stage { min-height: min(58vh, 420px); }
  }
  .hero-inner :global(a), .hero-inner :global(button) { pointer-events: auto; }
  /* A soft pool of shadow so the title reads over the station. */
  .hero-text::before {
    content: ''; position: absolute; inset: 0 auto 0 -20%; width: 70%; z-index: -1; pointer-events: none;
    background: radial-gradient(closest-side, rgb(7 9 14 / 0.55), rgb(7 9 14 / 0.2) 60%, transparent);
  }
  .hero h1, .hero-copy, .hero-motto { text-shadow: 0 0 24px rgb(7 9 14 / 0.9); }

  /* ---- 3D archive station (scripts/home3d.ts) --------------------------------- */
  .hero-3d { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 1; opacity: 0; transition: opacity 1.4s var(--ease-out); }
  .hero:global(.has-3d) .hero-3d { opacity: 1; }
  .orbit-links { position: absolute; inset: 0; z-index: 2; pointer-events: none; }
  .hero:not(:global(.has-3d)) .orbit-links { display: none; }
  .orbit-link { position: absolute; top: 0; left: 0; pointer-events: auto; border-radius: var(--radius-sm); color: var(--text); will-change: transform; transition: opacity var(--dur-base); }
  .orbit-link:hover { text-decoration: none; }
  .orbit-link:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  .orbit-link[data-behind] { opacity: 0; pointer-events: none; }
  .orbit-label {
    position: absolute; left: 0; top: 100%; margin-top: 6px; white-space: nowrap;
    display: inline-flex; align-items: center; gap: 7px;
    font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--text-muted);
    padding: 3px 10px; border: 1px solid var(--border); border-radius: 999px; background: rgb(7 9 14 / 0.55);
    transition: color var(--dur-fast), border-color var(--dur-fast);
  }
  .orbit-label small { color: var(--text-faint); letter-spacing: 0.06em; }
  .orbit-label .section-dot { box-shadow: 0 0 8px var(--dot); }
  .orbit-link:hover .orbit-label, .orbit-link:focus-visible .orbit-label { color: var(--accent); border-color: var(--accent); }

  /* ---- warp to the Library ---------------------------------------------------- */
  .hero::after { content: ''; position: absolute; inset: 0; z-index: 4; pointer-events: none; background: var(--bg); opacity: 0; }
  .hero:global(.is-warping)::after { opacity: 1; transition: opacity 380ms var(--ease-in) 760ms; }
  .hero:global(.is-warping) .hero-inner { opacity: 0; transform: scale(1.12); }
  .hero:global(.is-warping) .orbit-links { opacity: 0; transition: opacity 300ms; }
  .hero h1 {
    font-family: var(--font-display);
    font-weight: 500;
    letter-spacing: 0.32em;
    white-space: nowrap;
    font-size: clamp(2.2rem, 4.3vw, 4.4rem);
    margin: 18px 0 0;
    line-height: 1.05;
  }
  .hero h1 .word { display: block; }
  .hero h1 .ch { display: inline-block; }
  .hero h1 .sub { display: block; font-size: 0.3em; letter-spacing: 0.5em; color: var(--text-muted); margin-top: 14px; font-weight: 400; }
  .hero-motto { font-family: var(--font-mono); letter-spacing: 0.4em; text-transform: uppercase; font-size: 0.78rem; color: var(--accent); margin: 40px 0 14px; }
  .hero-copy { max-width: 44ch; margin: 0; color: var(--text-muted); }
  .hero-actions { display: flex; gap: 12px; justify-content: flex-start; flex-wrap: wrap; margin-top: 36px; }
  @media (max-width: 900px) {
    .hero h1 { font-size: clamp(2.2rem, 11vw, 3.6rem); padding-left: 0.32em; /* optically re-centre the tracked word */ }
    .hero-copy { margin: 0 auto; }
    .hero-actions { justify-content: center; }
  }
  .btn.ghost { border-color: var(--border); background: transparent; color: var(--text-muted); }
  .hero-stats { margin-top: 28px; font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-faint); letter-spacing: 0.1em; font-variant-numeric: tabular-nums; }
  .home-block { margin-top: 72px; }

  /* ---- opening sequence (html.home-intro, once per session) ---------------- */
  :global(html.home-intro) .hero-sky { animation: sky-in 1.4s var(--ease-out) both; }
  :global(html.home-intro) .hero h1 .ch {
    animation: letter-in 900ms var(--ease-out) both;
    animation-delay: calc(260ms + var(--i) * 70ms);
  }
  :global(html.home-intro) .hero h1 { animation: tracking-in 1.6s var(--ease-out) 200ms both; }
  :global(html.home-intro) .intro-step { animation: rise-in 800ms var(--ease-out) both; animation-delay: var(--d, 0ms); }
  @keyframes sky-in { from { opacity: 0; } }
  @keyframes letter-in { from { opacity: 0; transform: translateY(0.3em); filter: blur(8px); } }
  @keyframes tracking-in { from { letter-spacing: 0.62em; } }
  @keyframes rise-in { from { opacity: 0; transform: translateY(10px); } }

  /* ---- mini universe ---------------------------------------------------------- */
  .mini-universe {
    position: relative; display: block; margin-top: 16px; height: 340px;
    border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden;
    background: radial-gradient(ellipse at 50% 45%, var(--panel), var(--bg) 75%);
    color: var(--text);
    transition: border-color var(--dur-base);
  }
  .mini-universe:hover { border-color: var(--border-strong); text-decoration: none; }
  .mini-canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .mini-caption {
    position: absolute; left: 20px; bottom: 18px; display: grid; gap: 2px; pointer-events: none;
    font-size: 0.86rem; color: var(--text-muted);
  }
  .mini-caption strong { font-family: var(--font-mono); font-weight: 400; font-size: 0.75rem; letter-spacing: 0.12em; color: var(--text-faint); text-transform: uppercase; }
  @media (max-width: 640px) { .mini-universe { height: 260px; } }

  /* ---- "receiving" signal ------------------------------------------------------ */
  .signal { display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: var(--accent); margin-right: 10px; vertical-align: middle; animation: signal 2.6s ease-in-out infinite; }
  @keyframes signal { 0%, 100% { opacity: 0.25; } 50% { opacity: 1; } }
</style>

<script>
  import { countUp, motionEnabled, reveal } from '../scripts/motion';
  import { mountStarfield } from '../scripts/starfield';
  import { mountNebula } from '../scripts/nebula';
  import { mountGraph } from '../scripts/graph';

  const sky = mountStarfield(document.querySelector<HTMLCanvasElement>('.hero-sky')!);
  mountNebula(document.querySelector<HTMLCanvasElement>('.hero-nebula')!, sky.parallax);

  // The 3D archive station loads once fonts for its book spines are in (or after a short wait).
  const hero = document.querySelector<HTMLElement>('.hero')!;
  const webgl = (() => {
    try { const c = document.createElement('canvas'); return !!(c.getContext('webgl2') || c.getContext('webgl')); } catch { return false; }
  })();
  if (webgl) {
    const intro = document.documentElement.classList.contains('home-intro');
    const fonts = Promise.all([
      document.fonts.load('500 32px "Space Grotesk"'),
      document.fonts.load('500 32px "IBM Plex Sans Thai"', 'กขค'),
    ]).catch(() => {});
    Promise.all([import('../scripts/home3d'), Promise.race([fonts, new Promise((r) => setTimeout(r, 1500))])]).then(([{ mountHome3D }]) => {
      const data = JSON.parse(hero.querySelector('.orbit-data')!.textContent!);
      mountHome3D(hero, hero.querySelector<HTMLCanvasElement>('.hero-3d')!, data, { intro });
    });
  }

  // Stats count up as the opening sequence reaches them.
  if (document.documentElement.classList.contains('home-intro')) {
    document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => countUp(el, Number(el.dataset.count), 1400, 1400));
  }

  reveal(document.querySelectorAll<HTMLElement>('.home-cards .card'));
  reveal(document.querySelectorAll<HTMLElement>('.home-recent .note-list li'), 90);

  // The mini universe loads its data only when it comes near the viewport.
  const base = document.documentElement.dataset.base!;
  const mini = document.querySelector<HTMLCanvasElement>('.mini-canvas')!;
  const io = new IntersectionObserver(([e]) => {
    if (!e.isIntersecting) return;
    io.disconnect();
    fetch(`${base}graph.json`)
      .then((r) => r.json())
      .then((data) => mountGraph(mini, data, {
        base,
        preview: true,
        galaxies: true,
        intro: 'bang',
        ambient: true,
        drift: motionEnabled() ? 0.035 : 0,
        systemLabels: true,
        labelDegree: 99,
      }));
  }, { rootMargin: '200px' });
  io.observe(mini);
</script>
