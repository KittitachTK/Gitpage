---
import BaseLayout from '../layouts/BaseLayout.astro';
import NoteList from '../components/NoteList.astro';
import { SITE, href } from '../lib/config';
import { recent, sections } from '../lib/site';
import { getVault } from '../lib/vault/vault';
import { HEAVEN_ATTR } from '../lib/world';

const vault = getVault();
const secs = sections(vault).filter((s) => s.notes.length);
const latest = recent(vault, 6);
const stats = [
  { n: vault.notes.length, label: 'notes' },
  { n: vault.graph.links.length, label: 'connections' },
  { n: vault.tags.size, label: 'topics' },
];
const art = (f: string) => href(`art/${f}`);
---

<BaseLayout nav="home">
  <!--
    The Creation of Adam (Michelangelo, c. 1512), split along the gap between
    the fingers into two layers (public/art/creation-*.webp) so Adam and God can
    drift towards each other. Touching the spark between their fingers floods
    the fresco with light and descends into the garden library.
  -->
  <section class="hero" data-heaven={HEAVEN_ATTR} data-library={href('library')}>
    <!--
      Decide before the hero paints whether to play the opening sequence: once per
      session, and only with motion on. Inline so there is no flash of final state.
    -->
    <script is:inline>
      (function () {
        var r = document.documentElement, seen = null;
        var ok = r.dataset.motion === 'on' ||
          (r.dataset.motion !== 'off' && !matchMedia('(prefers-reduced-motion: reduce)').matches);
        try { seen = sessionStorage.getItem('planktos:intro'); } catch (e) {}
        if (ok && !seen) {
          r.classList.add('home-intro');
          try { sessionStorage.setItem('planktos:intro', '1'); } catch (e) {}
        }
      })();
    </script>

    <div class="fresco">
      <img class="f-base" src={art('creation-base.webp')} alt="" aria-hidden="true" />
      <div class="f-figure f-god" aria-hidden="true"><img src={art('creation-god.webp')} alt="" fetchpriority="high" /></div>
      <div class="f-figure f-adam" aria-hidden="true"><img src={art('creation-adam.webp')} alt="" fetchpriority="high" /></div>
      <span class="f-flare" aria-hidden="true"></span>
      <a class="spark" href={href('library')} data-touch>
        <span class="sr-only">Touch the spark and enter the garden library</span>
        <span class="spark-label" aria-hidden="true">Touch the spark</span>
      </a>
    </div>
    <canvas class="f-dust" aria-hidden="true"></canvas>
    <div class="f-wash" aria-hidden="true"></div>
    <div class="f-light" aria-hidden="true"></div>

    <div class="hero-inner">
      <header class="inscription">
        <p class="eyebrow intro-step" style="--d:2300ms">{SITE.tagline}</p>
        <h1 aria-label={`${SITE.name} ${SITE.subtitle}`}>
          <span class="word" aria-hidden="true">
            {[...SITE.name].map((ch, i) => <span class="ch" style={`--i:${i}`}>{ch}</span>)}
          </span>
          <span class="sub intro-step" style="--d:3000ms" aria-hidden="true">{SITE.subtitle}</span>
        </h1>
        <p class="motto intro-step" style="--d:3300ms"><i>Fiat lux</i> — let there be light</p>
      </header>

      <footer class="hero-foot intro-step" style="--d:3700ms">
        <div class="hero-actions">
          <a class="btn" href={href('library')} data-touch>Enter the garden</a>
          <a class="btn ghost" href={href('universe')}>Tree of Knowledge ❦</a>
        </div>
        <p class="hero-stats">
          {stats.map((s, i) => (
            <>
              {i > 0 && ' · '}
              <span data-count={s.n}>{s.n}</span> {s.label}
            </>
          ))}
        </p>
        <p class="hero-credit">Michelangelo, <i>The Creation of Adam</i>, Sistine Chapel, c. 1512</p>
      </footer>
    </div>
  </section>

  <section class="container home-block">
    <p class="eyebrow">Tree of knowledge</p>
    <a class="mini-universe space" href={href('universe')} aria-label="Open the Tree of Knowledge" style={`--art:url(${art('eden-1280.webp')})`}>
      <canvas class="mini-canvas" aria-hidden="true"></canvas>
      <span class="mini-caption">
        <strong>{vault.notes.length} fruits · {vault.graph.links.length} branches</strong>
        <span>Every note is a fruit; every link, a branch. Walk among them →</span>
      </span>
    </a>
  </section>

  <section class="container home-block">
    <p class="eyebrow">The library</p>
    <div class="grid home-cards" style="margin-top:16px">
      {
        secs.map((s) => (
          <a class="card" href={href(`library/${s.slug}`)} style={`--glow:${s.color}`}>
            <span class="count">
              <span class="section-dot" style={`--dot:${s.color}`} />
              {s.notes.length} notes
            </span>
            <h3 data-vt-title>{s.label}</h3>
            <p>{s.blurb}</p>
          </a>
        ))
      }
    </div>
  </section>

  <section class="container home-block home-recent">
    <p class="eyebrow"><span class="bud" aria-hidden="true"></span>New growth</p>
    <NoteList notes={latest} excerpt />
  </section>
</BaseLayout>

<style>
  /* ---- the fresco ------------------------------------------------------------
     The painting covers the hero like object-fit: cover, but keeps the gap
     between the fingers in view on narrow screens. Every layer shares the
     painting's box, so the split figures line up exactly at rest. */
  .hero {
    --ink: #3a2a18;
    --plaster: 236 228 210;
    position: relative;
    height: calc(100svh - var(--header-h));
    min-height: 540px;
    max-height: 1100px;
    overflow: hidden;
    container-type: size;
    background: rgb(var(--plaster));
    isolation: isolate;
  }
  .fresco {
    --ar: 2.2039;             /* painting width / height */
    --gx: 0.3788;             /* the gap between the fingers */
    --gy: 0.4553;
    --fx: 0.46;               /* horizontal point kept centred when the sides are cropped */
    --fw: max(100cqw, 100cqh * var(--ar));
    --fh: max(100cqh, 100cqw / var(--ar));
    position: absolute;
    width: var(--fw);
    height: var(--fh);
    left: clamp(100cqw - var(--fw), 50cqw - var(--fx) * var(--fw), 0px);
    top: clamp(100cqh - var(--fh), 50cqh - var(--gy) * var(--fh), 0px);
    transform-origin: calc(var(--gx) * 100%) calc(var(--gy) * 100%);
  }
  @container (max-aspect-ratio: 5/4) { .fresco { --fx: var(--gx); } }
  .fresco img, .f-figure { position: absolute; inset: 0; width: 100%; height: 100%; max-width: none; display: block; }
  .f-base { filter: saturate(0.9); }
  .f-figure { left: 0; top: 0; }

  /* Faint plaster wash behind the inscription and fade into the page below. */
  .f-wash {
    position: absolute; inset: 0; pointer-events: none;
    background:
      linear-gradient(180deg, rgb(var(--plaster) / 0.9), rgb(var(--plaster) / 0.55) 17%, rgb(var(--plaster) / 0) 36%),
      linear-gradient(0deg, var(--bg), color-mix(in srgb, var(--bg) 70%, transparent) 12%, transparent 30%),
      radial-gradient(ellipse 120% 90% at 40% 45%, transparent 55%, rgb(40 28 12 / 0.28));
  }
  .f-dust { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; mix-blend-mode: screen; }
  .f-light {
    position: absolute; inset: 0; z-index: 5; pointer-events: none; opacity: 0;
    background: radial-gradient(ellipse at 50% 42%, #fffdf6, #fbf0d6 55%, #f2dfae);
  }

  /* ---- the spark ------------------------------------------------------------ */
  .spark {
    position: absolute; z-index: 3;
    left: calc(var(--gx) * 100%); top: calc(var(--gy) * 100%);
    width: 76px; height: 76px; margin: -38px 0 0 -38px; border-radius: 50%;
    display: grid; place-items: center;
    -webkit-tap-highlight-color: transparent;
  }
  .spark::before {
    content: ''; position: absolute; inset: 22px; border-radius: 50%;
    background: radial-gradient(circle, #fffef8 0 12%, rgb(255 236 170 / 0.85) 30%, rgb(255 214 120 / 0.25) 60%, transparent 72%);
    animation: spark-pulse 3.2s ease-in-out infinite;
  }
  .spark:hover::before, .spark:focus-visible::before { inset: 10px; }
  .spark::before { transition: inset var(--dur-base) var(--ease-out); }
  .spark:focus-visible { outline: 1px solid rgb(138 100 32 / 0.7); outline-offset: 2px; }
  .spark-label {
    position: absolute; top: 100%; left: 50%; translate: -50% 0; margin-top: 30px; white-space: nowrap;
    font-family: var(--font-label); font-size: 0.7rem; letter-spacing: 0.32em; text-transform: uppercase; color: var(--ink);
    text-shadow: 0 0 10px rgb(var(--plaster)), 0 0 4px rgb(var(--plaster));
    transition: opacity var(--dur-base);
  }
  .spark-label::before { content: ''; position: absolute; left: 50%; bottom: calc(100% + 6px); width: 1px; height: 18px; background: linear-gradient(transparent, rgb(58 42 24 / 0.55)); }
  .spark:hover .spark-label { color: #8a6420; }
  @keyframes spark-pulse {
    0%, 100% { opacity: 0.55; transform: scale(0.85); }
    50% { opacity: 1; transform: scale(1.15); }
  }
  .f-flare {
    position: absolute; z-index: 2; left: calc(var(--gx) * 100%); top: calc(var(--gy) * 100%);
    width: 40px; height: 40px; margin: -20px 0 0 -20px; border-radius: 50%; pointer-events: none;
    background: radial-gradient(circle, #fffef8 0 20%, rgb(255 236 170 / 0.8) 45%, transparent 70%);
    opacity: 0; transform: scale(0.2);
  }

  /* ---- text over the fresco -------------------------------------------------- */
  .hero-inner {
    position: relative; z-index: 4; height: 100%; pointer-events: none;
    display: grid; grid-template-rows: auto 1fr auto; padding: clamp(18px, 4cqh, 44px) var(--gutter) clamp(16px, 3cqh, 32px);
    transition: opacity 500ms var(--ease-out);
  }
  .hero-inner :global(a) { pointer-events: auto; }
  .inscription { text-align: center; color: var(--ink); }
  .inscription .eyebrow { color: rgb(58 42 24 / 0.72); margin: 0; }
  .hero h1 { margin: 6px 0 0; line-height: 1; font-weight: 400; }
  .hero h1 .word {
    display: block; font-family: 'Cinzel', var(--font-display); font-weight: 500;
    font-size: clamp(2.1rem, min(7.4vw, 10cqh), 5.2rem); letter-spacing: 0.28em; padding-left: 0.28em; /* optically centre the tracked word */
    text-shadow: 0 1px 0 rgb(255 250 235 / 0.6), 0 0 28px rgb(var(--plaster));
  }
  .hero h1 .ch { display: inline-block; }
  .hero h1 .sub {
    display: block; margin-top: 8px; font-family: var(--font-display); font-style: italic; font-weight: 500;
    font-size: clamp(1.05rem, 2.2vw, 1.5rem); letter-spacing: 0.06em; color: rgb(58 42 24 / 0.82);
  }
  .motto { margin: 10px 0 0; font-family: var(--font-display); font-size: clamp(0.95rem, 1.6vw, 1.1rem); color: rgb(58 42 24 / 0.7); }
  .motto i { color: #7a3e2e; font-weight: 600; }

  .hero-foot { grid-row: 3; display: grid; justify-items: center; gap: 10px; text-align: center; }
  .hero-actions { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
  .hero .btn { background: color-mix(in srgb, var(--bg) 55%, transparent); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); }
  .btn.ghost { border-color: var(--border); color: var(--text-muted); }
  .hero-stats { margin: 4px 0 0; font-family: var(--font-label); font-size: 0.72rem; color: var(--text-muted); letter-spacing: 0.14em; font-variant-numeric: lining-nums tabular-nums; }
  .hero-credit { margin: 0; font-family: var(--font-display); font-size: 0.82rem; color: var(--text-faint); }
  @container (max-height: 640px) { .hero-credit, .motto { display: none; } }

  .home-block { margin-top: 72px; }

  /* ---- opening sequence (html.home-intro, once per session) ------------------
     Out of the light, the two figures drift towards each other until their
     fingers almost meet; then the inscription appears letter by letter.
     Only `backwards` fill, so the touch transitions below are never overridden. */
  :global(html.home-intro) .f-light { animation: light-out 2.2s var(--ease-out) backwards; }
  :global(html.home-intro) .fresco { animation: fresco-in 5s var(--ease-out) backwards; }
  :global(html.home-intro) .f-adam { animation: adam-in 3.8s cubic-bezier(0.16, 1, 0.3, 1) 0.2s backwards; }
  :global(html.home-intro) .f-god { animation: god-in 4.2s cubic-bezier(0.16, 1, 0.3, 1) 0.2s backwards; }
  :global(html.home-intro) .spark { animation: rise-in 900ms var(--ease-out) 3.6s backwards; }
  :global(html.home-intro) .hero h1 .ch { animation: letter-in 1100ms var(--ease-out) backwards; animation-delay: calc(2300ms + var(--i) * 90ms); }
  :global(html.home-intro) .intro-step { animation: rise-in 900ms var(--ease-out) backwards; animation-delay: var(--d, 0ms); }
  @keyframes light-out { from { opacity: 1; } }
  @keyframes fresco-in { from { transform: scale(1.12); filter: blur(3px) brightness(1.15); } }
  @keyframes adam-in { from { transform: translate(-8%, 2.5%) rotate(-0.6deg); } }
  @keyframes god-in { from { transform: translate(10%, -3.5%) rotate(0.8deg); } }
  @keyframes letter-in { from { opacity: 0; transform: translateY(0.25em); filter: blur(6px); } }
  @keyframes rise-in { from { opacity: 0; transform: translateY(10px); } }

  /* At rest the fingers breathe: never quite touching. */
  .f-god img { animation: god-breathe 7s ease-in-out infinite; }
  .f-adam img { animation: adam-breathe 7s ease-in-out infinite; }
  @keyframes god-breathe { 50% { translate: 0.22% -0.18%; } }
  @keyframes adam-breathe { 50% { translate: -0.08% 0.1%; } }

  /* ---- the touch, then the descent into the garden ------------------------------ */
  .f-figure { transition: left 560ms cubic-bezier(0.5, 0, 0.75, 0), top 560ms cubic-bezier(0.5, 0, 0.75, 0); }
  .hero.is-touching .f-god { left: -0.26%; top: 1.15%; }
  .hero.is-touching .f-adam { left: 0.1%; top: -0.3%; }
  .hero.is-touching .f-figure img { animation-play-state: paused; }
  .hero.is-touching .f-flare { opacity: 1; transform: scale(3); transition: opacity 260ms ease-out 420ms, transform 700ms var(--ease-out) 420ms; }
  .hero.is-touching .spark { opacity: 0; transition: opacity 200ms; }
  .hero.is-entering .fresco { scale: 7; transition: scale 1.5s cubic-bezier(0.6, 0, 0.85, 0.35); }
  .hero.is-entering .f-flare { transform: scale(60); transition: transform 1.4s cubic-bezier(0.5, 0, 0.9, 0.4); }
  .hero.is-entering .f-light { opacity: 1; transition: opacity 900ms ease-in 450ms; }
  .hero.is-entering .hero-inner, .hero.is-entering .f-dust { opacity: 0; transition: opacity 400ms var(--ease-out); }

  /* ---- tree of knowledge preview ------------------------------------------------- */
  .mini-universe {
    position: relative; display: block; margin-top: 16px; height: 340px;
    border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden;
    background:
      linear-gradient(180deg, rgb(4 6 4 / 0.55), rgb(4 6 4 / 0.82)),
      var(--art) 92% 22% / 220% auto;
    color: var(--text);
    transition: border-color var(--dur-base);
  }
  .mini-universe:hover { border-color: var(--border-strong); text-decoration: none; }
  .mini-canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .mini-caption {
    position: absolute; left: 20px; bottom: 18px; display: grid; gap: 2px; pointer-events: none;
    font-size: 0.86rem; color: var(--text-muted);
  }
  .mini-caption strong { font-family: var(--font-label); font-weight: 400; font-size: 0.75rem; letter-spacing: 0.12em; color: var(--text-faint); text-transform: uppercase; }
  @media (max-width: 640px) { .mini-universe { height: 260px; } }

  /* ---- a bud that slowly opens and closes ----------------------------------------- */
  .bud { display: inline-block; width: 7px; height: 7px; border-radius: 50% 0; background: var(--sec-computer-science); margin-right: 10px; vertical-align: middle; rotate: 45deg; animation: bud 3.2s ease-in-out infinite; }
  @keyframes bud { 0%, 100% { opacity: 0.45; scale: 0.85; } 50% { opacity: 1; scale: 1.1; } }
</style>

<script>
  import { countUp, motionEnabled, reveal } from '../scripts/motion';
  import { mountGraph } from '../scripts/graph';
  import { mountPollen } from '../scripts/pollen';

  const hero = document.querySelector<HTMLElement>('.hero')!;
  const spark = hero.querySelector<HTMLElement>('.spark')!;

  // Golden dust hanging in the light between the two hands.
  const focus = { x: 0.4, y: 0.45, spread: 0.12 };
  const placeFocus = () => {
    const h = hero.getBoundingClientRect(), s = spark.getBoundingClientRect();
    focus.x = (s.left + s.width / 2 - h.left) / h.width;
    focus.y = (s.top + s.height / 2 - h.top) / h.height;
    focus.spread = Math.min(0.22, 260 / h.width);
  };
  placeFocus();
  new ResizeObserver(placeFocus).observe(hero);
  mountPollen(hero.querySelector<HTMLCanvasElement>('.f-dust')!, { density: 2.4, color: '255,236,180', focus });

  // Touch: the fingers meet, light floods the fresco, and we descend into the garden.
  let entering = false;
  hero.addEventListener('click', (e) => {
    const a = (e.target as Element).closest<HTMLAnchorElement>('a[data-touch]');
    if (!a || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    if (!motionEnabled()) return; // a plain link
    e.preventDefault();
    if (entering) return;
    entering = true;
    hero.classList.add('is-touching');
    setTimeout(() => hero.classList.add('is-entering'), 560);
    setTimeout(() => {
      window.planktosWorld?.leaveFrom(hero.dataset.heaven!);
      try { sessionStorage.setItem('planktos:arrive', 'warp'); } catch {}
      location.assign(a.href);
    }, 560 + 1500);
  });
  // Coming back (bfcache): the fresco is as it was before the touch.
  addEventListener('pageshow', (e) => {
    if (!e.persisted) return;
    entering = false;
    hero.classList.remove('is-touching', 'is-entering');
  });

  // Stats count up as the opening sequence reaches them.
  if (document.documentElement.classList.contains('home-intro')) {
    document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => countUp(el, Number(el.dataset.count), 1400, 3700));
  }

  reveal(document.querySelectorAll<HTMLElement>('.home-cards .card'));
  reveal(document.querySelectorAll<HTMLElement>('.home-recent .note-list li'), 90);

  // The tree preview loads its data only when it comes near the viewport.
  const base = document.documentElement.dataset.base!;
  const mini = document.querySelector<HTMLCanvasElement>('.mini-canvas')!;
  const io = new IntersectionObserver(([e]) => {
    if (!e.isIntersecting) return;
    io.disconnect();
    fetch(`${base}graph.json`)
      .then((r) => r.json())
      .then((data) => mountGraph(mini, data, {
        base,
        preview: true,
        galaxies: true,
        intro: 'bang',
        ambient: true,
        drift: motionEnabled() ? 0.035 : 0,
        systemLabels: true,
        labelDegree: 99,
      }));
  }, { rootMargin: '200px' });
  io.observe(mini);
</script>
