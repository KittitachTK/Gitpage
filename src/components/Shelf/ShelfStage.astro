---
/**
 * The Library's zero-gravity bookshelf. Renders real links for every book
 * (mode "books") or shelf module (mode "boards"); src/scripts/shelf.ts lays
 * the 3D scene out underneath them. The default slot is the list view: shown
 * when the reader picks "List", without JavaScript, or without WebGL.
 */
import '../../styles/shelf.css';
import type { ShelfData } from '../../scripts/shelf';

interface Props {
  data: ShelfData;
  /** Accessible name of the shelf region. */
  label: string;
  /** Initial ?type= filter (section shelves). */
  filter?: string;
}
const { data, label, filter = '' } = Astro.props;
const json = JSON.stringify(data).replace(/</g, '\\u003c');
---

<div class="shelf-view" data-view="shelf" data-mode={data.mode}>
  <div class="shelf-toolbar">
    <slot name="toolbar" />
    <div class="shelf-switch" role="group" aria-label="View">
      <button type="button" data-set-view="shelf" aria-pressed="true">
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 4h2v11H3zM7 6h2v9H7zM11 3h2.2v12H11zM15 5.5l1.9-.5 2.4 9.6-1.9.5z" fill="currentColor"/><path d="M1.5 16.5h17" stroke="currentColor" stroke-width="1.4"/></svg>
        Shelf
      </button>
      <button type="button" data-set-view="list" aria-pressed="false">
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.6" fill="none"/></svg>
        List
      </button>
    </div>
  </div>

  <section class="shelf-stage space" aria-label={label} data-filter={filter}>
    <canvas class="shelf-sky" aria-hidden="true"></canvas>
    <canvas class="shelf-gl" aria-hidden="true"></canvas>
    <div class="shelf-overlay">
      {
        data.mode === 'books'
          ? data.boards.map((board) => (
              <div class="shelf-row" role="group" aria-label={`${board.label} · ${board.books.length} notes`}>
                {board.books.map((b) => (
                  <a class="shelf-link" href={b.url} data-id={b.id} data-type={b.type}>
                    <span class="shelf-link-title" data-vt-title>{b.title}</span>
                    <span class="sr-only">{[b.path, b.type, b.date].filter(Boolean).join(' · ')}</span>
                  </a>
                ))}
              </div>
            ))
          : data.boards.map((board) => (
              <a class="shelf-link shelf-module" href={board.url} data-id={board.id} style={`--dot:var(${board.color})`}>
                <span class="shelf-module-label">
                  <span class="shelf-module-count"><span class="section-dot" />{board.count ?? board.books.length} notes</span>
                  <h3 data-vt-title>{board.label}</h3>
                  {board.blurb && <span class="shelf-module-blurb">{board.blurb}</span>}
                </span>
              </a>
            ))
      }
    </div>
    {
      data.mode === 'books' && (
        <div class="shelf-holo" aria-hidden="true">
          <span class="holo-path" />
          <strong class="holo-title" />
          <span class="holo-meta" />
          <span class="holo-excerpt" />
        </div>
      )
    }
    <button type="button" class="shelf-nav shelf-prev" aria-label="Previous shelf" hidden>‹</button>
    <button type="button" class="shelf-nav shelf-next" aria-label="Next shelf" hidden>›</button>
    {data.mode === 'books' && <p class="shelf-hint" aria-hidden="true">Hover a volume · click to open · ← → ↑ ↓ to browse</p>}
    <script type="application/json" class="shelf-data" set:html={json} />
  </section>

  <div class="shelf-list">
    <slot />
  </div>
</div>

<noscript><style>.shelf-stage, .shelf-switch { display: none !important; } .shelf-view .shelf-list { display: block !important; }</style></noscript>

<script>
  import type { ShelfData } from '../../scripts/shelf';

  const KEY = 'planktos:library-view';

  for (const view of document.querySelectorAll<HTMLElement>('.shelf-view')) {
    const stage = view.querySelector<HTMLElement>('.shelf-stage')!;
    const buttons = [...view.querySelectorAll<HTMLButtonElement>('[data-set-view]')];
    let mounted = false;

    // Only the visible view may carry data-vt-title, so the page-title morph
    // starts from what the reader actually clicked.
    const setView = (v: 'shelf' | 'list', remember = true) => {
      view.dataset.view = v;
      for (const b of buttons) b.setAttribute('aria-pressed', String(b.dataset.setView === v));
      for (const el of stage.querySelectorAll('[data-vt-title], [data-vt-title-off]')) {
        if (v === 'shelf') { el.removeAttribute('data-vt-title-off'); el.setAttribute('data-vt-title', ''); }
        else { el.removeAttribute('data-vt-title'); el.setAttribute('data-vt-title-off', ''); }
      }
      if (remember) try { localStorage.setItem(KEY, v); } catch {}
      if (v === 'shelf') mount();
    };
    buttons.forEach((b) => b.addEventListener('click', () => setView(b.dataset.setView as 'shelf' | 'list')));

    const fallback = () => {
      setView('list', false);
      view.querySelector<HTMLElement>('.shelf-switch')!.hidden = true;
    };
    stage.addEventListener('shelf-fallback', fallback);

    const webgl = (() => {
      try {
        const c = document.createElement('canvas');
        return !!(c.getContext('webgl2') || c.getContext('webgl'));
      } catch { return false; }
    })();

    // Three.js and the fonts load only once the shelf is about to be seen.
    function mount() {
      if (mounted || !webgl) return;
      mounted = true;
      const io = new IntersectionObserver(async ([e]) => {
        if (!e.isIntersecting) return;
        io.disconnect();
        const data = JSON.parse(stage.querySelector('.shelf-data')!.textContent!) as ShelfData;
        const fonts = Promise.all([
          document.fonts.load('500 32px "Space Grotesk"'),
          document.fonts.load('500 32px "IBM Plex Sans Thai"', 'กขค'),
          document.fonts.load('600 16px "JetBrains Mono"'),
        ]).catch(() => {});
        const timeout = new Promise((r) => setTimeout(r, 2500));
        const [{ mountShelf }] = await Promise.all([import('../../scripts/shelf'), Promise.race([fonts, timeout])]);
        mountShelf(stage, data);
      }, { rootMargin: '200px 0px' });
      io.observe(stage);
    }

    let saved: string | null = null;
    try { saved = localStorage.getItem(KEY); } catch {}
    if (!webgl) fallback();
    else setView(saved === 'list' ? 'list' : 'shelf', false);
  }
</script>
