---
/**
 * The Library's zero-gravity bookshelf, full bleed: deep space fills the page,
 * a glass sidebar holds the page heading, filters and the list (always shown),
 * and src/scripts/shelf.ts frames the 3D shelves in the space beside it.
 * Every book / module is also a real link rendered here. Without JavaScript or
 * WebGL the sidebar simply takes the full width.
 *
 * Slots: "head" (page heading), "toolbar" (filters), default (the list).
 */
import '../../styles/shelf.css';
import type { ShelfData } from '../../scripts/shelf';

interface Props {
  data: ShelfData;
  /** Accessible name of the shelf region. */
  label: string;
  /** Initial ?type= filter (section shelves). */
  filter?: string;
}
const { data, label, filter = '' } = Astro.props;
const json = JSON.stringify(data).replace(/</g, '\\u003c');
---

<div class="shelf-view space" data-view="shelf" data-mode={data.mode}>
  <section class="shelf-stage" aria-label={label} data-filter={filter}>
    <canvas class="shelf-sky" aria-hidden="true"></canvas>
    <canvas class="shelf-gl" aria-hidden="true"></canvas>
    <div class="shelf-overlay">
      {
        data.mode === 'books'
          ? data.boards.map((board) => (
              <div class="shelf-row" role="group" aria-label={`${board.label} · ${board.books.length} notes`}>
                {board.books.map((b) => (
                  <a class="shelf-link" href={b.url} data-id={b.id} data-type={b.type}>
                    <span class="shelf-link-title">{b.title}</span>
                    <span class="sr-only">{[b.path, b.type, b.date].filter(Boolean).join(' · ')}</span>
                  </a>
                ))}
              </div>
            ))
          : data.boards.map((board) => (
              <a class="shelf-link shelf-module" href={board.url} data-id={board.id} style={`--dot:var(${board.color})`}>
                <span class="shelf-module-label">
                  <span class="shelf-module-count"><span class="section-dot" />{board.count ?? board.books.length} notes</span>
                  <span class="shelf-module-name">{board.label}</span>
                </span>
              </a>
            ))
      }
    </div>
    {
      data.mode === 'books' && (
        <div class="shelf-holo" aria-hidden="true">
          <span class="holo-path" />
          <strong class="holo-title" />
          <span class="holo-meta" />
          <span class="holo-excerpt" />
        </div>
      )
    }
    <script type="application/json" class="shelf-data" set:html={json} />
  </section>

  <div class="shelf-layout">
    <aside class="shelf-side">
      <slot name="head" />
      <slot name="toolbar" />
      <div class="shelf-list"><slot /></div>
    </aside>
    <div class="shelf-focus" aria-hidden="true">
      <button type="button" class="shelf-nav shelf-prev" aria-label="Previous shelf" tabindex="-1" hidden>‹</button>
      <button type="button" class="shelf-nav shelf-next" aria-label="Next shelf" tabindex="-1" hidden>›</button>
      {data.mode === 'books' && <p class="shelf-hint">Hover a volume · click to open · ← → ↑ ↓ to browse</p>}
    </div>
  </div>
</div>

<noscript><style>.shelf-view { --no-3d: 1; } .shelf-stage, .shelf-focus { display: none !important; } .shelf-layout { grid-template-columns: 1fr !important; }</style></noscript>

<script>
  import type { ShelfData } from '../../scripts/shelf';

  for (const view of document.querySelectorAll<HTMLElement>('.shelf-view')) {
    const stage = view.querySelector<HTMLElement>('.shelf-stage')!;

    // Set by the home station's warp just before it navigated here; consumed once.
    try {
      const arrive = sessionStorage.getItem('planktos:arrive');
      sessionStorage.removeItem('planktos:arrive');
      if (arrive) stage.dataset.arrive = arrive;
    } catch {}

    const fallback = () => (view.dataset.view = 'list');
    stage.addEventListener('shelf-fallback', fallback);

    const webgl = (() => {
      try {
        const c = document.createElement('canvas');
        return !!(c.getContext('webgl2') || c.getContext('webgl'));
      } catch { return false; }
    })();

    if (!webgl) fallback();
    else {
      // Fonts for the book spines first (or give up waiting after a moment), then Three.js.
      const data = JSON.parse(stage.querySelector('.shelf-data')!.textContent!) as ShelfData;
      const fonts = Promise.all([
        document.fonts.load('500 32px "Space Grotesk"'),
        document.fonts.load('500 32px "IBM Plex Sans Thai"', 'กขค'),
        document.fonts.load('600 16px "JetBrains Mono"'),
      ]).catch(() => {});
      const timeout = new Promise((r) => setTimeout(r, 2000));
      Promise.all([import('../../scripts/shelf'), Promise.race([fonts, timeout])]).then(([{ mountShelf }]) => mountShelf(stage, data));
    }
  }
</script>
