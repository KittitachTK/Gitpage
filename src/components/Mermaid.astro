---
/**
 * Renders every `<pre class="mermaid">` on the page. Mermaid is large, so it is
 * only loaded (as a separate chunk) on pages that actually contain a diagram.
 */
---

<script>
  async function renderMermaid() {
    const blocks = document.querySelectorAll<HTMLElement>('pre.mermaid:not([data-processed])');
    if (!blocks.length) return;
    const { default: mermaid } = await import('mermaid');
    mermaid.initialize({
      startOnLoad: false,
      securityLevel: 'loose', // allows `click node "url"` links in roadmaps
      theme: 'base',
      themeVariables: {
        darkMode: true,
        background: '#10141c',
        primaryColor: '#151a24',
        primaryBorderColor: '#2d3543',
        primaryTextColor: '#e6e2d8',
        lineColor: '#858076',
        secondaryColor: '#151a24',
        tertiaryColor: '#0b0e15',
        fontFamily: 'Inter, "IBM Plex Sans Thai", sans-serif',
      },
    });
    await mermaid.run({ nodes: [...blocks] });
  }
  renderMermaid();
</script>
