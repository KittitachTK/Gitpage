---
/**
 * The painted world behind every page: Thomas Cole, *The Garden of Eden* (1828,
 * public domain). Its "camera" pose comes from the page's scene (lib/world.ts);
 * BaseLayout's head script starts it where the previous page left it, and the
 * script below glides it to this page's pose, so moving through the site reads
 * as one continuous walk. Purely decorative.
 */
import { href } from '../lib/config';
---

<div class="eden-world" aria-hidden="true">
  <img
    class="ew-painting"
    src={href('art/eden-2400.webp')}
    srcset={`${href('art/eden-1280.webp')} 1280w, ${href('art/eden-2400.webp')} 2400w`}
    sizes="(max-aspect-ratio: 4/3) 220vh, 140vw"
    alt=""
    decoding="async"
    fetchpriority="low"
  />
  <div class="ew-night"></div>
  <div class="ew-veil"></div>
  <canvas class="ew-motes"></canvas>
  <div class="ew-light"></div>
</div>

<style is:global>
  /* Each pose value is a registered number so the walk eases smoothly between pages. */
  @property --wx { syntax: '<number>'; inherits: true; initial-value: 0.5; }
  @property --wy { syntax: '<number>'; inherits: true; initial-value: 0.66; }
  @property --wz { syntax: '<number>'; inherits: true; initial-value: 1; }
  @property --wv { syntax: '<number>'; inherits: true; initial-value: 0.8; }
  @property --wn { syntax: '<number>'; inherits: true; initial-value: 0; }
  @property --wl { syntax: '<number>'; inherits: true; initial-value: 0; }

  .eden-world {
    --ar: 1.3588; /* painting width / height */
    --dur: 1.6s;
    position: fixed; inset: 0; z-index: -1; overflow: hidden; pointer-events: none;
    container-type: size;
    background: var(--bg);
    view-transition-name: eden-world;
    transition:
      --wx var(--dur) var(--ease-in-out), --wy var(--dur) var(--ease-in-out), --wz var(--dur) var(--ease-in-out),
      --wv var(--dur) var(--ease-in-out), --wn var(--dur) var(--ease-in-out), --wl calc(var(--dur) * 0.8) var(--ease-in-out);
  }
  /* Coming down from the sky of the Creation is a longer, slower descent. */
  html[data-descent] .eden-world { --dur: 3.2s; }

  .ew-painting {
    --iw: max(100cqw, 100cqh * var(--ar));
    --ih: max(100cqh, 100cqw / var(--ar));
    position: absolute; left: 0; top: 0; max-width: none;
    width: var(--iw); height: var(--ih);
    /* Like object-position: the point (x, y) of the painting lands at (x, y) of the screen, then zoom around it. */
    translate: calc((100cqw - var(--iw)) * var(--wx)) calc((100cqh - var(--ih)) * var(--wy));
    transform-origin: calc(var(--wx) * 100%) calc(var(--wy) * 100%);
    scale: var(--wz);
    filter: saturate(0.92) contrast(1.02);
    opacity: 0; transition: opacity 900ms var(--ease-out);
  }
  .ew-painting.loaded { opacity: 1; }
  .ew-night { position: absolute; inset: 0; background: radial-gradient(ellipse at 70% 30%, #0b1210, #030504 80%); opacity: calc(var(--wn) * 0.85); }
  .ew-veil { position: absolute; inset: 0; background: var(--bg); opacity: var(--wv); }
  .ew-motes { position: absolute; inset: 0; width: 100%; height: 100%; }
  .ew-light { position: absolute; inset: 0; background: radial-gradient(ellipse at 50% 42%, #fffdf6, #fbf0d6 55%, #f2dfae); opacity: var(--wl); }

  ::view-transition-group(eden-world) { animation: none; }
  ::view-transition-old(eden-world) { display: none; }
  ::view-transition-new(eden-world) { animation: none; }

  html[data-motion='off'] .eden-world { transition: none; }
  @media (prefers-reduced-motion: reduce) { html:not([data-motion='on']) .eden-world { transition: none; } }
</style>

<script>
  import { mountPollen } from '../scripts/pollen';

  const world = document.querySelector<HTMLElement>('.eden-world')!;
  const img = world.querySelector<HTMLImageElement>('.ew-painting')!;
  const done = () => img.classList.add('loaded');
  if (img.complete) done();
  else img.addEventListener('load', done, { once: true });

  const root = document.documentElement;
  const num = (name: string) => parseFloat(getComputedStyle(world).getPropertyValue(name)) || 0;
  mountPollen(world.querySelector<HTMLCanvasElement>('.ew-motes')!, {
    density: 1.1,
    night: () => num('--wn'),
    alpha: () => 1 - num('--wv'),
  });

  // BaseLayout's head script painted the first frame at the previous page's pose;
  // once that frame is up, glide to this page's own pose.
  requestAnimationFrame(() => requestAnimationFrame(() => {
    window.planktosWorld?.go();
    setTimeout(() => delete root.dataset.descent, 3400);
  }));
</script>
